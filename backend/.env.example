# Copy to backend/.env and fill in. backend/.env is git-ignored.

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
# The key needs the "Text to Speech" permission.
ELEVENLABS_API_KEY=
# Any voice ID from your ElevenLabs Voice Library or your own cloned voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_v4_turbo: most expressive realtime model (websocket; falls back to eleven_turbo_v2_5 on error).
# Other options: eleven_turbo_v2_5 (fast, cheap), eleven_multilingual_v2 (natural, slower).
ELEVENLABS_MODEL=eleven_v4_turbo
